{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": false
  },
  "regions": [
    "fra1"
  ],
  "functions": {
    "app/api/companies/**/extended-quote/route.ts": {
      "maxDuration": 30
    },
    "app/(root)/research/**": {
      "maxDuration": 60
    },
    "app/(root)/export/**": {
      "maxDuration": 60
    },
    "app/(root)/calendar/**": {
      "maxDuration": 30
    },
    "app/api/thesis/**": {
      "maxDuration": 60
    },
    "app/api/news/**/second-order/route.ts": {
      "maxDuration": 60
    },
    "app/**/page.tsx": {
      "maxDuration": 10
    },
    "app/**/route.ts": {
      "maxDuration": 10
    }
  }
}
