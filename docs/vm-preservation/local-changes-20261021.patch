+def _name_tokens(name: str | None) -> list[str]:
+    """Tokens del nombre ya sin puntuacion pegada ("sciences," -> "sciences")."""
+    out: list[str] = []
+    for tok in fold(name or "").split():
+        tok = tok.strip(".,;:()\"'¡!¿?-/")
+        if tok:
+            out.append(tok)
+    return out
