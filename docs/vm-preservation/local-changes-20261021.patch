+                day = str(event.get("date") or "")
+                row = items.get(symbol)
+                if row is not None and day and row["next_earnings_date"] is None:
+                    row["next_earnings_date"] = day
+                    row["next_earnings_source"] = "NASDAQ (api.nasdaq.com)"
+        except Exception:
