+
+    fri_start, fri_end = ts(2026, 10, 16, 7, 0), ts(2026, 10, 16, 15, 30)
+    mon_start, mon_end = ts(2026, 10, 19, 7, 0), ts(2026, 10, 19, 15, 30)
+    minutes = list(range(fri_start, fri_end, 60))
