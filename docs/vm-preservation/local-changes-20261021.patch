+
+def _question_metrics(question: str) -> set[str]:
+    text = (question or "").lower()
+    found: set[str] = set()
+    for pattern, metrics in _METRIC_KEYWORDS:
+        if re.search(pattern, text):
+            found.update(metrics)
+    return found
+
