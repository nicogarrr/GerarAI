+                 "regularMarketPrice": 1477.2},
+        "timestamp": [ts(2026, 10, 15, 12, 0), ts(2026, 10, 16, 12, 0)],
+        "indicators": {"quote": [{"close": [1464.2, 1477.2]}]},
