+    def _fill_trailing_spot(series: list[Any]) -> list[Any]:
+        """Las filas finales sin adj_close (precio spot de Finnhub / Yahoo intradia)
+        usan `close`: tras el ultimo cierre ajustado no hay ajuste posterior que
