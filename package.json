{
  "name": "gerarai",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:flows": "E2E_UI_RUN=1 E2E_USER_FLOWS=1 playwright test e2e/user-flows --workers=1",
    "test:db": "node scripts/test-db.mjs",
    "diagnose:db": "node scripts/diagnose-db.mjs",
    "generate:openapi": "python data-engine/scripts/export_openapi.py && openapi-typescript data-engine/openapi.json -o lib/research/openapi.generated.ts",
    "test:auth": "node scripts/test-auth-signup.mjs",
    "repair:auth": "node scripts/repair-auth-store.mjs",
    "test:routes": "node scripts/check-routes.mjs",
    "test:guards": "node scripts/run-guards.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:summary": "node scripts/frontend-coverage-summary.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:contract": "node scripts/contract-drift.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^1.56.0",
    "mongoose": "^9.11.2",
    "next": "^16.3.6",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-select-country-list": "^2.2.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-select-country-list": "^2.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "postcss": "8.5.26"
  },
  "description": "GerarAI — Research OS de inversión personal (Next.js + FastAPI)"
}
