# CavaAI produccion personal (Oracle VM) - copia a .env.production y rellena.
# NUNCA subas .env.production al repo.

# Dominio del backend en la VM Oracle, sin https://. Prod usa sslip.io
# (dominio gratis sobre la IP publica) con Caddy: 51.170.37.134.sslip.io
BACKEND_DOMAIN=51.170.37.134.sslip.io
# Interfaz donde Caddy publica 80/443. 0.0.0.0 por defecto; si tailscaled ya
# ocupa :443 en la IP tailnet, pon aqui la IP privada de la VM (p.ej. 10.0.0.64).
BIND_IP=0.0.0.0

# Pool SQLAlchemy (solo Postgres). Backend 20+10; workers 4+2 via compose.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# WORKER_DB_POOL_SIZE=4
# WORKER_DB_MAX_OVERFLOW=2

# Postgres
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga-aleatoria
POSTGRES_DB=cavaai_research

# MinIO
MINIO_ROOT_USER=cavaai
MINIO_ROOT_PASSWORD=cambia-esto-tambien

# Firma de identidad frontend<->backend (debe coincidir con la de Vercel)
RESEARCH_AUTH_SECRET=

# Frontend en Vercel (mismos valores que en el dashboard de Vercel, paso 7 de oracle-setup.md)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://gerarai.vercel.app
NEXT_PUBLIC_SITE_URL=https://gerarai.vercel.app
# Contacto publicado en /privacidad y /terminos. Vacio = [PENDIENTE] visible.
NEXT_PUBLIC_SUPPORT_EMAIL=
MONGODB_URI=mongodb+srv://usuario:***@cluster.mongodb.net/cavaai?retryWrites=true&w=majority
# Telegram en prod: sin ENABLED=true no se envia nada (degradado a UI).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_ENABLED=false
INSIDER_ALERTS_ENABLED=false

# APIs externas (mismas claves que usas hoy)
FMP_API_KEY=
FINNHUB_API_KEY=
# LLM: decision explicita del dueno (2026-10-25). El cerebro es OpenCode Go
# con `deepseek-v4.1-flash`, cubierto por la suscripcion Go ya contratada:
# no es un proveedor nuevo ni un coste por token. Groq/Gemini/OpenRouter
# siguen opt-in y apagados por defecto.
LLM_ENABLED=true
LLM_PROVIDER=opencode-go
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Sin fallback implicito: la cadena Go/Groq/Gemini ya es el respaldo.
OPENCODE_GO_FALLBACK_MODEL=
OPENCODE_GO_REASONING_EFFORT=high
OPENCODE_GO_CHAT_REASONING_EFFORT=high
CHAT_TOTAL_TIMEOUT_SECONDS=45
# 1 = primario de chat por la suscripcion Go (default). 0 vuelve a la ruta
# free verificada: ajusta tambien OPENCODE_GO_MODEL a un free y la BASE_URL al
# bridge opcional (ver docs/AI_PROVIDER_STRATEGY.md).
CHAT_GO_SUBSCRIPTION_ENABLED=true
CHAT_GO_SUBSCRIPTION_BASE_URL=https://opencode.ai/zen/go/v1
# Solo para un piloto auditado con un modelo no aprobado. Nunca en prod normal.
OPENCODE_GO_ALLOW_UNVERIFIED_MODEL=false
# Bridge local OPCIONAL solo para free/legacy (data-engine/bridge/opencode_bridge.py,
# puerto 4098). El camino aprobado es la URL oficial Go de arriba.
# Tercer escalon SOLO para el chat: Groq (GPT-OSS 120B), apagado por defecto.
# Solo se activa si confirmas plan gratuito y ZDR (zero data retention).
GROQ_API_KEY=
GROQ_CHAT_FALLBACK_ENABLED=false
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
# Respaldo opcional del chat, DESPUES de Groq (orden: OpenCode, Groq, Gemini 3.5-lite, Gemini 3.8). Gemini free tier: confirma que la
# clave es de un proyecto SIN facturacion antes de activarlo.
GEMINI_API_KEY=
GEMINI_CHAT_FALLBACK_ENABLED=false
GEMINI_FREE_PLAN_CONFIRMED=false
# OpenRouter :free solo entra con clave y modelo :free; apagado por defecto.
OPENROUTER_API_KEY=

# Opcionales (tienen default, pero documentadas aquí)
FRED_API_KEY=
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Tenant dueño del token Flex (1 = cuenta propietaria). Sin el la sync diaria no corre.
IBKR_FLEX_TENANT_ID=
IBKR_FLEX_ACCOUNT_ID=
# Id de la consulta Flex declarada completa (sin filtros); igual a IBKR_FLEX_QUERY_ID para permitir cierres
IBKR_FLEX_COMPLETE_QUERY_ID=
TYPESAFE_API_KEY=
SCREENER_QUOTE_VENDOR=finnhub
FMP_BACKEND_URL=https://51.170.37.134.sslip.io
# Solo las leen las server actions del frontend (lib/actions/newsSources.actions.ts);
# el backend no las usa. Reservadas mientras no haya flujo que las consuma:
NEWSAPI_KEY=
MARKETAUX_API_KEY=

# RAG vectorial en prod (Qdrant va en el compose): opt-in por flags.
# Sin =1 no hay ingesta/busqueda/chat vectorial (degradado a SQL).
CAVAAI_ENABLE_VECTOR_INGEST=0
CAVAAI_ENABLE_VECTOR_SEARCH=0
CAVAAI_ENABLE_VECTOR_CHAT=0

# SEC EDGAR exige un User-Agent identificable CON CONTACTO REAL. Los valores
# con example.com/tu-email/tu-correo se rechazan en produccion (403 de la SEC).
SEC_USER_AGENT=GerarAI research tu-correo@tudominio-real.es

# Feeds RSS opcionales (separados por comas). Las agencias de notas de
# prensa (PR Newswire, GlobeNewswire, Business Wire) ya van incluidas en
# el codigo (PRESS_WIRE_RSS_FEEDS); aqui solo extras.
RSS_FEEDS=

# Langfuse Cloud EU shadow tracing (stage 3) — SOLO observabilidad, nunca
# fuente de verdad (eso es Postgres). Apagado por defecto; el tracer traga
# sus propios fallos y jamas rompe ejecuciones de negocio.
# - Solo metadatos de allowlist: NUNCA prompts, completions, payloads,
#   filings, auth headers ni IDs crudos (tenant = SHA-256 truncado).
# - Las claves van SOLO en este fichero en la VM (o en el gestor de secretos);
#   nunca en el repo. Las claves enseniadas por chat quedaron revocadas.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Host de la API/SDK para la region EU (Irlanda, eu-west-1), verificado:
# https://cloud.langfuse.com/api/public/health -> 200 OK. eu.cloud.langfuse.com
# es solo la web de signup/login (302 en la API): NO usarlo como host del SDK.
LANGFUSE_HOST=https://cloud.langfuse.com
# Muestreo de corridas OK (0.1 = 10%); los fallos se trazan siempre.
LANGFUSE_SAMPLE_RATE=0.1

# Garage (puente MinIO -> Garage, docs/OBJECT_STORAGE_MIGRATION.md).
# Garage arranca junto a MinIO; el backend sigue en MinIO hasta el corte.
GARAGE_RPC_SECRET=genera-con-openssl-rand-hex-32
GARAGE_ACCESS_KEY=GKgenera-GK-mas-24-hex
GARAGE_SECRET_KEY=genera-64-hex
# Corte: descomentar y recrear backend/worker*/scheduler. Rollback: comentar de nuevo.
# OBJECT_STORAGE_ENDPOINT=garage:3900
# OBJECT_STORAGE_ACCESS_KEY=${GARAGE_ACCESS_KEY}
# OBJECT_STORAGE_SECRET_KEY=${GARAGE_SECRET_KEY}
# OBJECT_STORAGE_REGION=garage

# Solicitudes de acceso (registro cerrado). Se guardan siempre en Mongo; el aviso por correo
# solo sale si hay destino Y credencial SMTP (p. ej. Gmail con contrasena de aplicacion).
# La contrasena va en las variables del entorno de despliegue, nunca en el repo.
ACCESS_REQUEST_NOTIFY_EMAIL=
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=

# Privacidad y retencion. El TTL de Mongo expira solicitudes de acceso; la
# purga de Postgres (documentos financieros y telemetria del chat) esta
# APAGADA por defecto y nace en dry-run. Ver docs/PRIVACY_AND_DATA_RETENTION.md.
# El TTL de Mongo sobre access_requests es opt-in y borra lo ya existente: no activar sin contar candidatos.
# ACCESS_REQUEST_TTL_ENABLED=false
ACCESS_REQUEST_RETENTION_DAYS=365
# FINANCIAL_DOCUMENT_RETENTION_DAYS=2555
# CHAT_TELEMETRY_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=false
RETENTION_DRY_RUN=true
# RETENTION_BATCH_LIMIT=500

# RAG de conocimiento profesional (cartas, libros, memos; docs/knowledge-rag.md).
# Apagado por defecto: con el flag a 0 la API responde 503 y el actor rechaza el trabajo.
# Activar solo con worker-knowledge levantado y disco: la ingesta rechaza si queda menos
# de KNOWLEDGE_RAG_MIN_FREE_GB libres. Los ficheros van en ./knowledge-inbox (se monta
# :ro en backend y worker-knowledge); la API nunca recibe bytes, solo rutas relativas.
# KNOWLEDGE_RAG_ENABLED=1
# KNOWLEDGE_RAG_COLLECTION=knowledge_rag_v1
# KNOWLEDGE_RAG_MAX_FILE_MB=60
# KNOWLEDGE_RAG_MIN_FREE_GB=3
# KNOWLEDGE_RAG_DOCLING_OCR=0
# KNOWLEDGE_RAG_DOCLING_TABLE_MODE=fast
# Reranker CPU opcional (vacio = desactivado). Medir en el piloto antes de activar.
# KNOWLEDGE_RAG_RERANKER_MODEL=
