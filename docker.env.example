# ============================================
# Variables de entorno para Docker
# ============================================
# Copia este archivo como .env y rellena los valores.
#
# Uso:
#   cp docker.env.example .env
#   docker compose up --build
#
# AVISO: los defaults de infra abajo son SOLO para desarrollo local.
# No uses estos secretos en producción. Preferible: docker-compose.dev.yml
# con puertos de DB no expuestos al host.

# Market data API keys
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
# ERP del WACC: prima implícita mensual de Damodaran (NYU Stern, gratuita y citada).
# 0 = volver al valor fijo de settings (wacc_equity_risk_premium).
WACC_DAMODARAN_ERP=1
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Tenant dueño del token Flex (1 = cuenta propietaria). Sin el la sync diaria no corre.
IBKR_FLEX_TENANT_ID=
SEC_USER_AGENT=GerarAI research contact@gerarai.local
# Solo las leen las server actions del frontend (lib/actions/newsSources.actions.ts);
# el backend no las usa. Reservadas mientras no haya flujo que las consuma:
NEWSAPI_KEY=
MARKETAUX_API_KEY=
# Fuente alternativa de noticias que SI lee el frontend
# (lib/actions/newsSources.actions.ts):
ALPHA_VANTAGE_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
# Research auth (ventana HMAC, CORS, workers):
RESEARCH_AUTH_MAX_AGE_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./portfolio_research_os.db
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9002
MINIO_BUCKET=research
DUCKDB_PATH=./storage/analytics.duckdb
WORKERS_ENABLED=true
APP_ENV=local
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_PUBLIC_SIGNUP=false
REQUIRE_EMAIL_VERIFICATION=false
E2E_AUTH_SECRET=
# Feeds RSS opcionales (URLs separadas por comas; los consume el worker).
# Las agencias de notas de prensa (PR Newswire, GlobeNewswire, Business Wire)
# ya van incluidas en el codigo (PRESS_WIRE_RSS_FEEDS); aqui solo extras.
RSS_FEEDS=

# LLM: decision del dueno (2026-10-25). El cerebro es OpenCode Go con
# `deepseek-v4.1-flash`, cubierto por la suscripcion Go ya contratada (no es
# un proveedor nuevo ni un coste por token). El endpoint aprobado es
# /zen/go/v1. El bridge local (data-engine/bridge/opencode_bridge.py, puerto
# 4098) queda OPCIONAL solo para free/legacy.
LLM_ENABLED=true
LLM_PROVIDER=opencode-go
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_FALLBACK_MODEL=
OPENCODE_GO_REASONING_EFFORT=high
# Reasoning SOLO del chat interactivo (backend). High para DeepSeek.
OPENCODE_GO_CHAT_REASONING_EFFORT=high
CHAT_TOTAL_TIMEOUT_SECONDS=45
CHAT_GO_SUBSCRIPTION_ENABLED=true
CHAT_GO_SUBSCRIPTION_BASE_URL=https://opencode.ai/zen/go/v1
# Solo para un piloto auditado con un modelo no aprobado.
OPENCODE_GO_ALLOW_UNVERIFIED_MODEL=false
# Respaldos gratuitos si OpenCode Go falla (chat y trabajos en segundo plano).
# Orden: OpenCode Go -> Groq (GPT-OSS 120B) -> Gemini 3.5-lite -> Gemini 3.8
# (en el chat, OpenRouter :free va tras Groq). Ninguno es un servicio de pago
# nuevo: solo planes gratuitos ya implementados.
# *_CHAT_FALLBACK_ENABLED admite tres valores:
#   auto  (defecto) -> entra SOLO si estan la clave y las confirmaciones de
#                      abajo; sin clave se salta (nunca se finge una respuesta).
#   false           -> apagado aunque haya clave.
#   true            -> obligatorio: si falta la clave o una confirmacion, falla.
# Sin ninguna clave de respaldo y con Go caido, el chat responde en modo
# determinista (datos guardados, marcado como fallback) y no inventa texto.
# Groq: confirma plan gratuito Y ZDR (zero data retention) en console.groq.com.
GROQ_API_KEY=
GROQ_CHAT_FALLBACK_ENABLED=auto
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
# Gemini (AI Studio): confirma que la clave es de un proyecto SIN facturacion
# (una clave de un proyecto con facturacion COBRA). El free tier puede usar los
# prompts para mejorar sus productos.
GEMINI_API_KEY=
GEMINI_CHAT_FALLBACK_ENABLED=auto
GEMINI_FREE_PLAN_CONFIRMED=false
# OpenRouter :free solo entra con clave y modelo :free (y con Groq activo).
OPENROUTER_API_KEY=
# Modo degradado explicito: LLM_PROVIDER=disabled (o LLM_ENABLED=false) no
# construye proveedor; el chat contesta en modo determinista y /health/ready
# informa `llm: error:disabled_by_configuration`.

# Cascada gratuita (LLM_PROVIDER=cascade): Gemini AI Studio -> OpenRouter :free -> OpenCode,
# solo los miembros con clave. Claves en el entorno de despliegue, nunca en el repo.
# Privacidad: con cascade cualquier prompt puede ir al free tier de Gemini (Google puede usarlo para
# mejorar sus productos). Coste: una clave Gemini en un proyecto CON facturacion cobra; usa una clave de
# proyecto sin facturacion. Los flujos con guardia de coste (propuestas LLM, bottleneck, narrativa de
# noticias) NO admiten cascade: quedan bloqueados (modelo_no_gratuito). Cascada total 60 s: el tercer
# miembro puede quedarse sin tiempo. OpenRouter :free no garantiza json_schema estricto.
# GEMINI_MODEL=gemini-3.8-flash
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Telegram alerts (leave disabled until a rotated BotFather token is configured)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Shared server-only HMAC secret (>=32 chars) for Asistenta link proof.
TELEGRAM_LINK_SECRET=
TELEGRAM_CHAT_ID=

# Thesis approval via Telegram (human-in-the-loop; poller getUpdates).
# Off by default. Con TELEGRAM_APPROVAL_ENABLED=true, generar una tesis envía
# sendMessage con botones inline ✅ Publicar / ✏️ Revisar; el script
# data-engine/scripts/telegram_approval_poll.py procesa los callbacks.
TELEGRAM_APPROVAL_ENABLED=false
# TELEGRAM_APPROVAL_STATE_PATH=./storage/telegram_approval_offset
# TELEGRAM_APPROVAL_POLL_INTERVAL_SECONDS=15

# Senales insider (Form 4 EDGAR): alerta Telegram 'insider buy' apagada por defecto.
INSIDER_ALERTS_ENABLED=false

# Correo de alertas por SMTP (canal "email"; avisos DCA de watchlist + cartera).
# Vacío = sin SMTP: el canal email no envía nada (o usa el webhook de correo si existe).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true y en SMTP_PASSWORD
# una CONTRASEÑA DE APLICACIÓN (myaccount.google.com/apppasswords, exige 2FA), nunca
# la contraseña de la cuenta. Puerto 465 => SMTP_SSL=true y SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente visible (p. ej. el mismo correo de SMTP_USERNAME con Gmail).
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=20
# Destinatarios de las alertas, separados por comas.
ALERT_EMAIL_TO=

# Señales DCA por niveles (1X-4X + recortes) de watchlist + cartera, tras el cierre (23:15 UTC L-V).
# DCA_ALERT_MIN_LEVEL: nivel mínimo de compra que avisa (1-4); cada ticker puede ajustarlo en la UI.
# DCA_ALERT_TRIMS=true avisa también de las zonas de recorte.
# DCA_ALERT_CHANNELS: canales base; Telegram se añade solo con la suscripción "dca_levels" activa.
DCA_ALERTS_ENABLED=true
DCA_ALERT_MIN_LEVEL=2
DCA_ALERT_TRIMS=false
DCA_ALERT_CHANNELS=in_app,email

# Avisos de próximos resultados (7, 1 y 0 días antes) de cartera + watchlist, estilo Investing.
# EARNINGS_ALERT_CHANNELS: canales base; Telegram/push solo con la suscripción "earnings" activa.
# El canal "email" solo se anuncia con el SMTP configurado (SMTP_HOST + SMTP_FROM +
# ALERT_EMAIL_TO); sin SMTP los avisos quedan solo in_app aunque se pida "email".
EARNINGS_ALERTS_ENABLED=true
EARNINGS_ALERT_CHANNELS=in_app,email

# Auth (32+ chars; example generator: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace_with_a_32_char_minimum_secret
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://root:example@localhost:27017/cavaai?authSource=admin
RESEARCH_AUTH_REQUIRED=true
RESEARCH_AUTH_SECRET=replace_with_an_independent_32_char_research_secret

# Infra secrets (required for compose — change in any shared/prod environment)
# docker-compose.yml publica los puertos solo en 127.0.0.1. Para exponerlos a la red
# (p. ej. otro equipo de la LAN) pon GERARAI_BIND_HOST=0.0.0.0 y cambia antes estas contraseñas.
GERARAI_BIND_HOST=127.0.0.1
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=cavaai_research
MINIO_ROOT_USER=portfolio
MINIO_ROOT_PASSWORD=portfoliosecret

# Research OS / observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
# (solo referencia: docker-compose.yml fuerza http://langfuse-web:3000
# dentro del backend; este valor vale para scripts fuera de compose)
LANGFUSE_SAMPLE_RATE=0.1
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=cavaai-local-langfuse-salt
LANGFUSE_INIT_USER_PASSWORD=

# RAG vectorial local (Qdrant en docker-compose, puerto 6333)
# Activa ingesta de vectores (embeddings locales all-MiniLM-L6-v2, gratis),
# busqueda semantica en /api/search y contexto vectorial en /api/chat.
QDRANT_URL=http://localhost:6333
VECTOR_STORE=qdrant
CAVAAI_ENABLE_VECTOR_INGEST=1
CAVAAI_ENABLE_VECTOR_SEARCH=1
CAVAAI_ENABLE_VECTOR_CHAT=1

# Backend FastAPI local (lo usa el frontend en dev; en prod es la URL de Oracle)
FMP_BACKEND_URL=http://127.0.0.1:8000

# TypeSafe Jev (opcional, micro-decisiones; gratis en Vercel AI Gateway)
#TYPESAFE_API_KEY=

# Proveedor de quotes del screener (opcional; default documentado en el backend)
#SCREENER_QUOTE_VENDOR=

# Solicitudes de acceso (registro cerrado). Se guardan siempre en Mongo; el aviso por correo
# solo sale si hay destino Y credencial SMTP (p. ej. Gmail con contrasena de aplicacion).
# La contrasena va en las variables del entorno de despliegue, nunca en el repo.
ACCESS_REQUEST_NOTIFY_EMAIL=
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=

# Privacidad y retencion. La purga de Postgres esta apagada por defecto y,
# al encenderla, empieza en dry-run. Ver docs/PRIVACY_AND_DATA_RETENTION.md.
ACCESS_REQUEST_RETENTION_DAYS=365
# FINANCIAL_DOCUMENT_RETENTION_DAYS=2555
# CHAT_TELEMETRY_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=false
RETENTION_DRY_RUN=true
# RETENTION_BATCH_LIMIT=500

# Seguimiento de errores 500 (opcional, sin dependencias): DSN con protocolo
# Sentry; GlitchTip autoalojado es gratis. Vacio = apagado.
# ERROR_TRACKING_DSN=https://<clave>@<host>/<proyecto>
# ERROR_TRACKING_ENVIRONMENT=production
