# TLS automatico (Let's Encrypt) para el backend personal.
# BACKEND_DOMAIN se inyecta desde .env.production (p.ej. 51.170.37.134.sslip.io).
{$BACKEND_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8000
}

# Oracle frontend. Keep the backend block and Vercel deployment unchanged.
gerarai.duckdns.org {
	encode zstd gzip
	reverse_proxy gerarai-frontend:3000
}
