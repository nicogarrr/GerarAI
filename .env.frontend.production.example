# Copy to .env.frontend.production (mode 600). Preserve existing auth secrets.
FRONTEND_IMAGE_TAG=oracle
FRONTEND_ENV_FILE=.env.frontend.production
BACKEND_DOCKER_NETWORK=cavaai_default
NEXT_PUBLIC_APP_URL=https://gerarai.duckdns.org
NEXT_PUBLIC_SITE_URL=https://gerarai.duckdns.org
BETTER_AUTH_URL=https://gerarai.duckdns.org
BETTER_AUTH_SECRET=
MONGODB_URI=
RESEARCH_AUTH_SECRET=
FMP_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_SUPPORT_EMAIL=
ALLOW_PUBLIC_SIGNUP=false
SIGNUP_ALLOWLIST=
# Frontend password reset credentials, not backend SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
